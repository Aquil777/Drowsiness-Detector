<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A0F">

    <!-- SKIP — top right, hidden on last page -->
    <TextView
        android:id="@+id/btnSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SALTAR"
        android:textColor="#3A3F50"
        android:textSize="11sp"
        android:fontFamily="@font/jetbrains_mono"
        android:letterSpacing="0.1"
        android:padding="16dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="4dp"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- PAGER fills between top and bottom bar -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/onboardingPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"/>

    <!-- BOTTOM BAR: ← · dots · SEGUINTE -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="40dp"
        android:background="#080A0F"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Previous -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrevious"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="←"
            android:textColor="#5A5F6E"
            android:textSize="18sp"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            app:strokeColor="#1E2230"
            app:cornerRadius="12dp"
            android:visibility="invisible"/>

        <!-- Dots -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <View android:id="@+id/dot1"
                android:layout_width="20dp" android:layout_height="4dp"
                android:background="@drawable/dot_active"
                android:layout_marginHorizontal="4dp"/>
            <View android:id="@+id/dot2"
                android:layout_width="6dp" android:layout_height="4dp"
                android:background="@drawable/dot_inactive"
                android:layout_marginHorizontal="4dp"/>
            <View android:id="@+id/dot3"
                android:layout_width="6dp" android:layout_height="4dp"
                android:background="@drawable/dot_inactive"
                android:layout_marginHorizontal="4dp"/>
            <View android:id="@+id/dot4"
                android:layout_width="6dp" android:layout_height="4dp"
                android:background="@drawable/dot_inactive"
                android:layout_marginHorizontal="4dp"/>
        </LinearLayout>

        <!-- Next / Começar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="SEGUINTE"
            android:textColor="#000000"
            android:textSize="11sp"
            android:fontFamily="@font/jetbrains_mono_bold"
            android:letterSpacing="0.08"
            android:paddingHorizontal="24dp"
            app:backgroundTint="#C8AB5A"
            app:cornerRadius="12dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>